node_modules/
dist/
.vite-cache/
.env*.local
*.log
.browser-errors.log
.browser-errors.seq
# add-component's record lock, its guard and the marker or temporary file of a guard takeover,
# left behind only by a run that was killed.
.aether/*.lock
.aether/*.lock.guard
.aether/*.lock.guard.*

# The monorepo root .gitignore has a broad `lib/` rule that also matches this
# template's `src/lib/`. Re-include it so source files aren't silently dropped.
!src/lib/
!src/lib/**
